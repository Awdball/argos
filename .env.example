# Database (CNPG PostgreSQL in Kubernetes, or sqlite:///argos.db for local dev)
DATABASE_URL=postgresql+psycopg://argos:changeme@postgres-rw:5432/argos

# Telegram Bot (@awdargos_bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local AI (In-cluster Ollama)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=90

# Home location & dynamic geo-radius defaults
HOME_POSTAL=76227
HOME_LAT=33.2259
HOME_LON=-96.9997
CRAIGSLIST_SITE=dallas
RADIUS_BASE_MILES=20
RADIUS_MID_MILES=40
RADIUS_HIGH_MILES=60

# Alerting & Feedback
PRICE_DROP_REALERT_PCT=0.10
TIMING_SNOOZE_DAYS=14

# Optional Phase 1/2/3 External Providers (all optional; Phase 1 runs at $0 without them)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
WOOT_API_KEY=
APIFY_TOKEN=
APIFY_MONTHLY_BUDGET_USD=4.50
KEEPA_API_KEY=
SERPAPI_KEY=

# Service controls
PORT=8080
ENABLE_TELEGRAM=true
ENABLE_SCHEDULER=true
LOG_LEVEL=INFO
